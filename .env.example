# Resend API key used by the contact form (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that receives contact form leads
CONTACT_EMAIL=hello@velouralunelle.com

# Optional: sender address for lead emails. Must use a domain verified in Resend.
# Without it, Resend's test sender is used, which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL="Veloura Lunelle Website <website@velouralunelle.com>"

# Public site URL (no trailing slash). Used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://tech.velouralunelle.com

# Booking link for "Book a Call" buttons
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/velouralunelle/free-consultation

# WhatsApp number in international format, digits only (no +, spaces or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER=15555550123

# Optional: site ownership codes (only the content="..." value of the HTML meta tag)
# Google Search Console → Add property → URL prefix → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag
NEXT_PUBLIC_BING_SITE_VERIFICATION=
